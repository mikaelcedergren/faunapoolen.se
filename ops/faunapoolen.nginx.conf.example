# faunapoolen.se prelaunch HTTP config.
# Requires shared nginx rate-limit and proxy snippets from /Users/cortex/Development/server-ops/templates.

server {
  listen 80;
  server_name faunapoolen.se www.faunapoolen.se;

  location ^~ /.well-known/acme-challenge/ {
    root /opt/homebrew/var/www/letsencrypt;
    default_type "text/plain";
  }

  location / {
    proxy_pass http://127.0.0.1:3040;
    include snippets/project-proxy-common.conf;
  }
}
