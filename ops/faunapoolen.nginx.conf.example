# faunapoolen.se prelaunch HTTP config.
# Requires shared nginx snippets from /Users/cortex/Development/server-ops/templates.
# After certificate issuance, replace it with faunapoolen.nginx.live.conf.example.

server {
  listen 80;
  server_name faunapoolen.se www.faunapoolen.se;

  location ^~ /.well-known/acme-challenge/ {
    root /opt/homebrew/var/www/letsencrypt;
    default_type "text/plain";
  }

  location = /healthz {
    proxy_pass http://127.0.0.1:3040;
    include snippets/project-proxy-common.conf;
  }

  location / {
    proxy_pass http://127.0.0.1:3040;
    include snippets/project-proxy-common.conf;
    include snippets/project-proxy-cache.conf;
  }
}
