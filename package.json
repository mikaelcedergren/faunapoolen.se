{
  "name": "faunapoolen.se",
  "version": "2.0.0",
  "private": true,
  "description": "Faunapoolen — Angular 22 SSG site (prerendered to dist/browser, served by Express). Public HTTPS is served from the Mac mini through the shared static-IP nginx path.",
  "author": "Mikael Cedergren <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://faunapoolen.se",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/faunapoolen.se.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "pnpm favicon:check && node scripts/dev.mjs",
    "build": "pnpm run build:browser && pnpm run build:server",
    "build:browser": "ng build --configuration prod && node scripts/flatten.mjs",
    "build:server": "pnpm --filter faunapoolen-server run build",
    "build:server:release": "node server/node_modules/@mikaelcedergren/cx-framework/scripts/cx-server-artifact.mjs --package faunapoolen-server",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\" && node scripts/flatten.mjs",
    "build:local": "pnpm favicon:check && ng build --configuration local && node scripts/flatten.mjs",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "start": "pnpm run start:web",
    "start:web": "node server/dist/index.js",
    "start:worker": "node server/dist/worker.js",
    "serve": "pnpm run start:web",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:server",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "pnpm --filter faunapoolen-server run typecheck",
    "test": "pnpm run test:server",
    "test:server": "pnpm run build:server && pnpm --filter faunapoolen-server run test && node --test tests/server/dev-launcher.test.mjs",
    "test:verification": "node --test tests/change-verification.test.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "favicon:generate": "cx-development-favicon --apply",
    "favicon:check": "cx-development-favicon",
    "platform:check": "cx-platform-check --root .",
    "verify:change": "node scripts/verify-change.mjs",
    "check": "pnpm run format:check && pnpm run favicon:check && pnpm run platform:check && pnpm run typecheck && pnpm run test:verification && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "ag-charts-community": "^13.3.1",
    "compression": "^1.7.5",
    "express": "^5.2.1",
    "ipaddr.js": "^2.4.0",
    "marked": "^18.0.7",
    "openai": "^6.47.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.5",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "1.60.0",
    "pnpm": "11.23.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  }
}
