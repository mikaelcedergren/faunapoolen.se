# @mikaelcedergren/cx-framework is installed but intentionally NOT imported into the public site,
# and never will be — faunapoolen.se keeps its own public skin as a permanent visual exception, with
# the package kept only for future admin/internal screens. It declares Angular 22 peers this Angular
# 22 SSG site already provides directly, so don't pull extra Angular copies in for the peer, and
# don't fail the install over the (intentional) peer skew.
auto-install-peers=false
strict-peer-dependencies=false
