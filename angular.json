{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "faunapoolen": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "fp",
      "i18n": {
        "sourceLocale": { "code": "en", "subPath": "en" },
        "locales": {
          "sv": { "translation": "src/locale/messages.sv.json", "subPath": "" },
          "da": { "translation": "src/locale/messages.da.json", "subPath": "da" }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "polyfills": ["zone.js", "@angular/localize/init"],
            "i18nMissingTranslation": "error",
            "i18nDuplicateTranslation": "error",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "{robots.txt,sitemap.xml}",
                "input": "public",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "public/assets",
                "output": "assets"
              },
              {
                "glob": "*.woff2",
                "input": "node_modules/@mikaelcedergren/cx-framework/fonts",
                "output": "assets/fonts"
              }
            ],
            "styles": ["src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "local": {
              "fileReplacements": [{ "replace": "src/main.ts", "with": "src/main.local.ts" }],
              "index": {
                "input": "src/index.development.html",
                "output": "index.html"
              },
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "prod": {
              "localize": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kb",
                  "maximumError": "1.5mb"
                }
              ]
            }
          },
          "defaultConfiguration": "local"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "local": {
              "buildTarget": "faunapoolen:build:local"
            }
          },
          "defaultConfiguration": "local"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
