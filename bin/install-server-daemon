#!/usr/bin/env bash
# Validate or install the Faunapoolen web and jobs-worker system LaunchDaemons. Installation never
# loads or restarts either role; release selection and activation stay separate operations.
set -euo pipefail

SOURCE_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
INSTALL_ROOT="/Users/cortex/Development/faunapoolen.se"
readonly SHARED_INSTALLER="$SOURCE_ROOT/../server-ops/bin/install-launchdaemon-definitions.mjs"
MODE="check"

if [[ "$#" -gt 1 ]]; then
  echo "Usage: bin/install-server-daemon [--check|--apply]" >&2
  exit 2
fi
case "${1:-}" in
  ""|--check)
    ;;
  --apply)
    MODE="apply"
    ;;
  *)
    echo "Usage: bin/install-server-daemon [--check|--apply]" >&2
    exit 2
    ;;
esac

LABELS=("com.faunapoolen.server" "com.faunapoolen.jobs")
ENTRYPOINTS=("server/dist/index.js" "server/dist/worker.js")
TEMPLATES=(
  "$SOURCE_ROOT/launchd/com.faunapoolen.server.plist"
  "$SOURCE_ROOT/launchd/com.faunapoolen.jobs.plist"
)
RENDER_DIR="$(mktemp -d "/tmp/faunapoolen-server-daemons.XXXXXX")"
trap 'rm -rf "$RENDER_DIR"' EXIT

for index in "${!TEMPLATES[@]}"; do
  template="${TEMPLATES[$index]}"
  label="${LABELS[$index]}"
  entrypoint="${ENTRYPOINTS[$index]}"
  rendered="$RENDER_DIR/$label.plist"
  if [[ ! -f "$template" ]]; then
    echo "FATAL: template missing: $template" >&2
    exit 1
  fi
  cp "$template" "$rendered"
  /usr/bin/plutil -lint "$rendered" >/dev/null
  /usr/bin/python3 - "$rendered" "$label" "$INSTALL_ROOT" "$entrypoint" <<'PY'
import plistlib
import sys

path, expected_label, repo_root, entrypoint = sys.argv[1:]
with open(path, "rb") as handle:
    payload = plistlib.load(handle)
if payload.get("Label") != expected_label:
    raise SystemExit(f"FATAL: wrong LaunchDaemon label in {path}")
if payload.get("UserName") != "cortex" or payload.get("GroupName") != "staff":
    raise SystemExit(f"FATAL: wrong LaunchDaemon runtime identity in {path}")
expected_program = [
    "/opt/homebrew/bin/node",
    f"{repo_root}/.run/site-releases/server/current-server/artifact/{entrypoint}",
]
if payload.get("ProgramArguments") != expected_program:
    raise SystemExit(f"FATAL: wrong selected server entrypoint in {path}")
if payload.get("WorkingDirectory") != repo_root:
    raise SystemExit(f"FATAL: wrong operational working root in {path}")
environment = payload.get("EnvironmentVariables")
if not isinstance(environment, dict):
    raise SystemExit(f"FATAL: missing LaunchDaemon environment in {path}")
expected_identity = f"{repo_root}/.run/site-releases/server/current-server/server-release.json"
expected_environment = {
    "APP_BASE_URL": "https://faunapoolen.se",
    "CAMPAIGN_GENERATION_ENABLED": "0",
    "CX_SERVER_RELEASE_IDENTITY_FILE": expected_identity,
    "DATA_DIR": "data",
    "DB_PATH": "data/faunapoolen.db",
    "NODE_ENV": "production",
    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
}
if expected_label.endswith(".server"):
    expected_environment.update({"HOST": "127.0.0.1", "PORT": "3040"})
else:
    expected_environment["OPENAI_MODEL"] = "gpt-5.6-terra"
if environment != expected_environment:
    raise SystemExit(f"FATAL: LaunchDaemon environment is not the exact {expected_label} allowlist in {path}")
if payload.get("RunAtLoad") is not True:
    raise SystemExit(f"FATAL: RunAtLoad is not enabled in {path}")
keep_alive = payload.get("KeepAlive")
if not isinstance(keep_alive, dict) or keep_alive.get("SuccessfulExit") is not False:
    raise SystemExit(f"FATAL: crash restart behavior is invalid in {path}")
PY
done

if [[ "$MODE" == "check" ]]; then
  echo "VALID: Faunapoolen web and jobs-worker LaunchDaemon templates"
  echo "No service was installed, loaded, or restarted."
  echo "Current runtime and release operations are owned by the shared server standard."
  exit 0
fi

if [[ "$SOURCE_ROOT" != "$INSTALL_ROOT" ]]; then
  echo "FATAL: --apply is allowed only from the canonical production checkout: $INSTALL_ROOT" >&2
  exit 1
fi

SELECTED_ROOT="$INSTALL_ROOT/.run/site-releases/server/current-server"
/usr/bin/python3 - \
  "$INSTALL_ROOT" \
  "$SELECTED_ROOT/server-release.json" \
  "$SELECTED_ROOT/artifact/server/dist/index.js" \
  "$SELECTED_ROOT/artifact/server/dist/worker.js" \
  "$INSTALL_ROOT/.env.web" \
  "$INSTALL_ROOT/.env.worker" \
  "$INSTALL_ROOT/data/faunapoolen.db" <<'PY'
import os
import stat
import sys

(
    repo_root,
    identity,
    web_entrypoint,
    worker_entrypoint,
    web_private,
    worker_private,
    database,
) = sys.argv[1:]
release_root = os.path.realpath(os.path.join(repo_root, ".run", "site-releases", "server"))
for path in (identity, web_entrypoint, worker_entrypoint):
    try:
        metadata = os.stat(path)
    except OSError as error:
        raise SystemExit(f"FATAL: selected server release is incomplete: {path}: {error}")
    resolved = os.path.realpath(path)
    if os.path.commonpath((release_root, resolved)) != release_root or not stat.S_ISREG(metadata.st_mode):
        raise SystemExit(f"FATAL: selected server release path is unsafe: {path}")
for path in (web_private, worker_private, database):
    try:
        metadata = os.lstat(path)
    except OSError as error:
        raise SystemExit(f"FATAL: required private runtime file is unavailable: {path}: {error}")
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or metadata.st_uid != os.geteuid()
        or stat.S_IMODE(metadata.st_mode) != 0o600
    ):
        raise SystemExit(
            f"FATAL: private runtime file must be one owned mode-0600 regular file: {path}"
        )
PY

if [[ ! -f "$SHARED_INSTALLER" ]]; then
  echo "FATAL: shared LaunchDaemon definition installer is missing: $SHARED_INSTALLER" >&2
  exit 1
fi

/opt/homebrew/bin/node "$SHARED_INSTALLER" \
  --apply \
  --definition "${LABELS[0]}=$RENDER_DIR/${LABELS[0]}.plist" \
  --definition "${LABELS[1]}=$RENDER_DIR/${LABELS[1]}.plist"

echo "No service was loaded or restarted."
echo "Activation requires separate restart authorisation and complete selected-release verification."
