# @mikaelcedergren/cx-framework is installed and used only for admin/internal screens — currently
# the campaigns tool at /admin. It is intentionally not imported into the public site, which keeps
# its own public skin as a permanent visual exception. The package declares Angular 22 peers this
# Angular 22 SSG site already provides directly, so don't pull extra Angular copies in for the peer,
# and don't fail the install over the intentional peer skew.
auto-install-peers=false
strict-peer-dependencies=false
