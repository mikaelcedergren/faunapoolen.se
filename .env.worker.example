# Faunapoolen jobs-worker secret. Copy to `.env.worker`, keep mode 0600, and never commit it.
OPENAI_API_KEY=replace-with-provider-key

# Enquiry notifications are independent of campaign generation.
# The owner preview also honours these mail-only settings.
ENQUIRY_EMAIL_ENABLED=0
BREVO_API_KEY=replace-with-brevo-key
COMPANY_EMAIL=replace-with-recipient
