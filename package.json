{
  "name": "faunapoolen.se",
  "version": "2.0.0",
  "private": true,
  "description": "Faunapoolen — Angular 22 SSG site (prerendered to dist/browser, served by Express). Public site runs on its existing host; this repo is prepared on the Mac mini in HTTP prelaunch (DNS not yet cut over).",
  "author": "Mikael Cedergren <michael@wargr.com>",
  "license": "UNLICENSED",
  "homepage": "https://faunapoolen.se",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelcedergren/faunapoolen.se.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "ng build --configuration prod && node scripts/flatten.mjs",
    "build:release": "ng build --configuration prod --output-path \"$SITE_RELEASE_DIR\" && node scripts/flatten.mjs",
    "build:local": "ng build --configuration local && node scripts/flatten.mjs",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "start": "node server/index.mjs",
    "serve": "node server/index.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:admin": "node --test server/admin-ad-builder.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/localize": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@mikaelcedergren/cx-framework": "github:mikaelcedergren/cx-framework#main",
    "compression": "^1.7.5",
    "express": "^5.2.1",
    "ipaddr.js": "^2.4.0",
    "openai": "^6.47.0",
    "parse5": "^8.0.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@playwright/test": "1.60.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mikaelcedergren/cx-framework",
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  }
}
